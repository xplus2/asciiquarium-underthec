#!/bin/sh
set -e

prefix=/usr/local
cc=${CC:-cc}
static=1
debug=0
emcc=0
host=
xscr_bindir=
xscr_configdir=
vlock_moduledir=
plasma=1
qml_dir=
plasma_pkgdir=
saver_dir=
android_ndk=
android_abi=arm64-v8a
android_api=21

for arg in "$@"; do
	case "$arg" in
	--prefix=*) prefix="${arg#--prefix=}" ;;
	--host=*) host="${arg#--host=}"; cc="${host}-gcc" ;;
	--no-static) static=0 ;;
	--debug) debug=1 ;;
	--emcc) emcc=1; cc=emcc ;;
	--xscreensaver-bindir=*) xscr_bindir="${arg#--xscreensaver-bindir=}" ;;
	--xscreensaver-configdir=*) xscr_configdir="${arg#--xscreensaver-configdir=}" ;;
	--vlock-moduledir=*) vlock_moduledir="${arg#--vlock-moduledir=}" ;;
	--no-plasma-wallpaper) plasma=0 ;;
	--qml-moduledir=*) qml_dir="${arg#--qml-moduledir=}" ;;
	--plasma-packagedir=*) plasma_pkgdir="${arg#--plasma-packagedir=}" ;;
	--macos-saverdir=*) saver_dir="${arg#--macos-saverdir=}" ;;
	--android-ndk=*) android_ndk="${arg#--android-ndk=}" ;;
	--android-abi=*) android_abi="${arg#--android-abi=}" ;;
	--android-api=*) android_api="${arg#--android-api=}" ;;
	--help)
		echo "usage: ./configure [--prefix=DIR] [--host=TRIPLET] [--no-static] [--debug] [--emcc]"
		echo "                   [--xscreensaver-bindir=DIR] [--xscreensaver-configdir=DIR]"
		echo "                   [--vlock-moduledir=DIR] [--no-plasma-wallpaper]"
		echo "                   [--qml-moduledir=DIR] [--plasma-packagedir=DIR]"
		echo "                   [--macos-saverdir=DIR]"
		echo "                   [--android-ndk=DIR] [--android-abi=ABI] [--android-api=N]"
		echo ""
		echo "  --prefix=DIR    install prefix (default: /usr/local)"
		echo "  --host=TRIPLET  cross-compiler prefix, e.g. x86_64-w64-mingw32, i586-pc-msdosdjgpp"
		echo "  --no-static     do not pass -static to the linker"
		echo "  --debug         build with -g -O0 and keep symbols (skip stripping)"
		echo "  --emcc          WebAssembly build with Emscripten (build/underthec.js, .wasm, index.html)"
		echo "  --xscreensaver-bindir=DIR    install dir (default: PREFIX/libexec/xscreensaver)"
		echo "  --xscreensaver-configdir=DIR install dir (default: PREFIX/libexec/xscreensaver)"
		echo "  --vlock-moduledir=DIR        install dir (default: /usr/lib/vlock/modules)"
		echo "  --no-plasma-wallpaper        don't build Plasma wallpaper (needs Qt6 Quick 6.4+)"
		echo "  --qml-moduledir=DIR          QML import dir (default: Qt's own)"
		echo "  --plasma-packagedir=DIR      install dir (default: PREFIX/share/plasma/wallpapers/org.underthec.wallpaper)"
		echo "  --macos-saverdir=DIR         macOS screensaver install dir (default: /Library/Screen Savers)"
		echo "  --android-ndk=DIR            Android NDK build of libunderthec_android.so (no APK)"
		echo "  --android-abi=ABI            arm64-v8a (default), armeabi-v7a, x86_64, x86"
		echo "  --android-api=N              minimum API level (default: 21)"
		exit 0
		;;
	*)
		echo "configure: unknown option '$arg'" >&2
		exit 1
		;;
	esac
done

if [ -z "$xscr_bindir" ]; then xscr_bindir="$prefix/libexec/xscreensaver"; fi
if [ -z "$xscr_configdir" ]; then xscr_configdir="$prefix/libexec/xscreensaver"; fi
if [ -z "$vlock_moduledir" ]; then vlock_moduledir="/usr/lib/vlock/modules"; fi

if [ -z "$saver_dir" ]; then saver_dir="/Library/Screen Savers"; fi

if [ -z "$plasma_pkgdir" ]; then plasma_pkgdir="$prefix/share/plasma/wallpapers/org.underthec.wallpaper"; fi

ver_str=$(sed -n 's/^#define TOOL_VERSION "\(.*\)"$/\1/p' src/version.h)
ver_parts=$(for p in MAJOR MINOR PATCH; do sed -n "s/^#define TOOL_VERSION_$p \([0-9]*\)$/\1/p" src/version.h; done | paste -sd. -)
if [ "$ver_str" != "$ver_parts" ]; then
	echo "configure: src/version.h: TOOL_VERSION $ver_str != MAJOR.MINOR.PATCH $ver_parts" >&2
	exit 1
fi

if [ "$emcc" = "1" ] && [ -n "$host" ]; then
	echo "configure: --emcc and --host are mutually exclusive" >&2
	exit 1
fi
android=0
if [ -n "$android_ndk" ]; then
	android=1
	if [ "$emcc" = "1" ] || [ -n "$host" ]; then
		echo "configure: --android-ndk excludes --emcc and --host" >&2
		exit 1
	fi
	case "$android_abi" in
	arm64-v8a) android_triple=aarch64-linux-android ;;
	armeabi-v7a) android_triple=armv7a-linux-androideabi ;;
	x86_64) android_triple=x86_64-linux-android ;;
	x86) android_triple=i686-linux-android ;;
	*)
		echo "configure: unknown android abi '$android_abi'" >&2
		exit 1
		;;
	esac
	android_bin=$(ls -d "$android_ndk"/toolchains/llvm/prebuilt/*/bin 2>/dev/null | head -n 1)
	if [ -z "$android_bin" ]; then
		echo "configure: no llvm toolchain in $android_ndk" >&2
		exit 1
	fi
	cc="$android_bin/${android_triple}${android_api}-clang"
	if [ ! -x "$cc" ]; then
		echo "configure: $cc not found (api $android_api)" >&2
		exit 1
	fi
fi
if [ "$emcc" = "1" ] || [ "$android" = "1" ]; then
	static=0
fi

srcs="src/app.c src/opts.c src/canvas.c src/color.c src/rng.c src/entity/utf8.c src/entity/list.c src/entity/shape.c src/entity/tick.c src/entity/seaweed.c src/entity/collide.c src/entity/draw.c src/ui/help.c src/ui/settings.c src/scene/scene.c src/scene/effects.c src/scene/creatures.c src/scene/environment.c src/scene/kaiju.c src/scene/fishhook.c src/scene/feed.c src/scene/turtle.c"

if [ "$emcc" = "1" ]; then
	srcs="$srcs src/config.c src/target/web/web_main.c"
elif [ "$android" = "1" ]; then
	srcs="$srcs src/config.c src/target/androidtv/android_main.c"
else
	core_srcs="$srcs"
	srcs="$srcs src/main.c src/ui/args.c src/ui/cli_help.c src/target/teletext/tt_render.c src/target/teletext/tt_t42.c src/target/teletext/tt_ts.c src/target/teletext/tt_net.c"
	windows=0
	dos=0
	case "$host" in
	*mingw*) windows=1 ;;
	*djgpp*) dos=1 ;;
	"")
		case "$(uname -s 2>/dev/null)" in
		*MINGW*|*MSYS*) windows=1 ;;
		esac
		;;
	esac
	if [ "$dos" = "1" ]; then
		srcs="$srcs src/target/terminal/term_dos.c"
		target=underthc.exe
	elif [ "$windows" = "1" ]; then
		srcs="$srcs src/target/terminal/term_common.c src/target/terminal/term_windows.c"
		rc="src/target/windows/underthec.rc"
		term_ldflags="-lshell32"
		scr_srcs="$core_srcs src/config.c src/target/scr_windows/scr_main.c src/target/scr_windows/scr_cfg.c"
		if [ -n "$host" ]; then windres="${host}-windres"; else windres=windres; fi
	else
		srcs="$srcs src/target/terminal/term_common.c src/target/terminal/term_posix.c"
		is_macos=0
		if [ -z "$host" ] && [ "$(uname -s 2>/dev/null)" = "Darwin" ]; then is_macos=1; fi
		if [ "$is_macos" != "1" ]; then
			vlock_srcs="$core_srcs src/config.c src/target/terminal/term_posix.c src/target/vlock/vlock_module.c"
		else
			saver_srcs="$core_srcs src/config.c src/target/scr_macos/saver_view.m src/target/scr_macos/saver_cfg.m"
		fi
	fi
fi

have_x11=0
x11_cflags=
x11_libs=
have_xft=0
xft_cflags=
xft_libs=

if [ "$emcc" != "1" ] && [ "$android" != "1" ] && [ "$windows" != "1" ] && [ -z "$host" ]; then
	tmpc="${TMPDIR:-/tmp}/underthec-x11check-$$.c"
	tmpo="${TMPDIR:-/tmp}/underthec-x11check-$$.out"
	if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists x11 2>/dev/null; then
		have_x11=1
		x11_cflags=$(pkg-config --cflags x11)
		x11_libs=$(pkg-config --libs x11)
	else
		printf '#include <X11/Xlib.h>\nint main(void){XOpenDisplay(0);return 0;}\n' > "$tmpc"
		if "$cc" "$tmpc" -lX11 -o "$tmpo" >/dev/null 2>&1; then
			have_x11=1
			x11_libs="-lX11"
		fi
		rm -f "$tmpc" "$tmpo"
	fi
	if [ "$have_x11" = "1" ]; then
		if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists xft 2>/dev/null; then
			have_xft=1
			xft_cflags=$(pkg-config --cflags xft)
			xft_libs=$(pkg-config --libs xft)
		else
			printf '#include <X11/Xft/Xft.h>\nint main(void){return 0;}\n' > "$tmpc"
			if "$cc" "$tmpc" -lXft -lX11 -o "$tmpo" >/dev/null 2>&1; then
				have_xft=1
				xft_libs="-lXft -lX11"
			fi
			rm -f "$tmpc" "$tmpo"
		fi
	fi
fi

have_qt=0
cxx=${CXX:-c++}
qt_cflags=
qt_libs=
qt_moc=

if [ "$plasma" = "1" ] && [ "$emcc" != "1" ] && [ "$android" != "1" ] && [ "$windows" != "1" ] && [ -z "$host" ] && [ "$(uname -s 2>/dev/null)" != "Darwin" ]; then
	if command -v pkg-config >/dev/null 2>&1 && pkg-config --atleast-version=6.4 Qt6Quick 2>/dev/null && command -v "$cxx" >/dev/null 2>&1; then
		qt_libexec=$(pkg-config --variable=libexecdir Qt6Core 2>/dev/null)
		for cand in "$qt_libexec/moc" "$(command -v moc-qt6 2>/dev/null)" "$(command -v moc6 2>/dev/null)"; do
			if [ -n "$cand" ] && [ -x "$cand" ]; then
				qt_moc="$cand"
				break
			fi
		done
		if [ -n "$qt_moc" ]; then
			have_qt=1
			qt_cflags=$(pkg-config --cflags Qt6Quick)
			qt_libs=$(pkg-config --libs Qt6Quick)
			if [ -z "$qml_dir" ]; then
				for q in qtpaths6 qmake6; do
					if command -v "$q" >/dev/null 2>&1; then
						if [ "$q" = "qtpaths6" ]; then qml_dir=$("$q" --query QT_INSTALL_QML 2>/dev/null); else qml_dir=$("$q" -query QT_INSTALL_QML 2>/dev/null); fi
						[ -n "$qml_dir" ] && break
					fi
				done
			fi
			if [ -z "$qml_dir" ]; then qml_dir="$(pkg-config --variable=libdir Qt6Core)/qt6/qml"; fi
		fi
	fi
fi

cflags="-std=c11 -Wall -Wextra -Isrc"
if [ "$dos" = "1" ]; then cflags="-std=gnu11 -Wall -Wextra -Isrc -march=i386"; fi
if [ "$android" = "1" ]; then cflags="$cflags -fPIC"; fi
if [ "$have_x11" = "1" ]; then
	cflags="$cflags $x11_cflags $xft_cflags"
	if [ "$have_xft" = "1" ]; then cflags="$cflags -DHAVE_XFT"; fi
fi
ldflags=""

if [ "$debug" = "1" ]; then
	cflags="$cflags -g -O0"
else
	cflags="$cflags -O2"
	if [ "$emcc" = "1" ]; then
		ldflags="$ldflags -O2"
	elif [ "$android" = "1" ]; then
		ldflags="$ldflags -s"
	elif [ "$dos" = "1" ]; then
		ldflags="$ldflags -s"
	else
		cflags="$cflags -flto=auto"
		ldflags="$ldflags -s -flto=auto"
	fi
fi

if [ "$emcc" = "1" ]; then
	ldflags="$ldflags -sMODULARIZE=1 -sEXPORT_NAME=underthec -sENVIRONMENT=web -sALLOW_MEMORY_GROWTH=1"
	ldflags="$ldflags -sEXPORTED_FUNCTIONS=_web_opt,_web_init,_web_fps,_web_resize,_web_key,_web_click,_web_frame,_web_width,_web_height,_web_settings_open,_web_help_open"
	ldflags="$ldflags -sEXPORTED_RUNTIME_METHODS=HEAPU32,ccall"
elif [ "$android" = "1" ]; then
	ldflags="$ldflags -shared -llog"
elif [ "$static" = "1" ] && [ "$dos" != "1" ]; then
	case "$(uname -s 2>/dev/null)" in
	Darwin) : ;; # macOS does not support fully static libSystem binaries
	*) ldflags="$ldflags -static" ;;
	esac
	case "$host" in
	*mingw*) ldflags="$ldflags -static" ;;
	esac
fi

{
	echo "CC = $cc"
	echo "CFLAGS = $cflags"
	echo "LDFLAGS = $ldflags"
	echo "PREFIX = $prefix"
	echo "SRCS = $srcs"
	if [ -n "$target" ]; then
		echo "TARGET = $target"
	fi
	if [ -n "$rc" ]; then
		echo "RC = $rc"
	fi
	if [ -n "$term_ldflags" ]; then
		echo "TERM_LDFLAGS = $term_ldflags"
	fi
	if [ "$emcc" = "1" ]; then
		echo 'TARGET = $(BUILDDIR)/underthec.js'
		echo 'WEB_FILES = $(BUILDDIR)/index.html $(BUILDDIR)/favicon.ico $(BUILDDIR)/apple-touch-icon.png'
	fi
	if [ "$android" = "1" ]; then
		echo 'TARGET = $(BUILDDIR)/libunderthec_android.so'
		echo "ANDROID = $android_abi"
	fi
	if [ -n "$scr_srcs" ]; then
		echo 'SCR_TARGET = $(BUILDDIR)/underthec.scr'
		echo "SCR_SRCS = $scr_srcs"
		echo "SCR_RC = src/target/scr_windows/scr.rc"
		echo "WINDRES = $windres"
		echo "SCR_LDFLAGS = -mwindows -lgdi32 -ladvapi32"
	fi
	if [ "$have_x11" = "1" ]; then
		echo 'XSCR_TARGET = $(BUILDDIR)/underthec-xscr'
		echo "XSCR_SRCS = $core_srcs src/config.c src/target/scr_x11/xscr_main.c src/target/scr_x11/xscr_font.c"
		echo "XSCR_LDFLAGS = $x11_libs $xft_libs"
		echo "XSCR_BINDIR = $xscr_bindir"
		echo "XSCR_CONFIGDIR = $xscr_configdir"
	fi
	if [ -n "$saver_srcs" ]; then
		echo 'SAVER_TARGET = $(BUILDDIR)/underthec.saver/Contents/MacOS/underthec'
		echo "SAVER_SRCS = $saver_srcs"
		echo "SAVER_VERSION = $ver_str"
		echo "SAVER_DIR = $saver_dir"
	fi
	if [ -n "$vlock_srcs" ]; then
		echo 'VLOCK_TARGET = $(BUILDDIR)/underthec.so'
		echo "VLOCK_SRCS = $vlock_srcs"
		echo "VLOCK_MODULEDIR = $vlock_moduledir"
	fi
	if [ "$have_qt" = "1" ]; then
		echo 'PLASMA_TARGET = $(BUILDDIR)/plasma_wallpaper/qml/org/underthec/libunderthec_qml.so'
		echo "PLASMA_C_SRCS = $core_srcs src/config.c"
		echo "PLASMA_CXX_SRCS = src/target/plasma/plasma_item.cpp src/target/plasma/plasma_plugin.cpp"
		echo "CXX = $cxx"
		echo "MOC = $qt_moc"
		echo "PLASMA_INCS = -Isrc -Isrc/target/plasma $qt_cflags"
		qt_sys=$(echo "$qt_cflags" | sed 's/-I/-isystem /g')
		echo "PLASMA_CXXFLAGS = -std=c++17 -Wall -Wextra -Isrc -Isrc/target/plasma $qt_sys $([ "$debug" = "1" ] && echo "-g -O0" || echo "-O2")"
		echo "PLASMA_LDFLAGS = $qt_libs"
		echo "PLASMA_QMLDIR = $qml_dir"
		echo "PLASMA_PACKAGEDIR = $plasma_pkgdir"
	fi
} > config.mk

echo "configured: CC=$cc static=$static debug=$debug emcc=$emcc screensaver=$([ -n "$scr_srcs" ] && echo 1 || echo 0) prefix=$prefix"
echo "xscreensaver: x11=$have_x11 xft=$have_xft$([ "$have_x11" = "1" ] && echo " bindir=$xscr_bindir")"
echo "vlock: enabled=$([ -n "$vlock_srcs" ] && echo 1 || echo 0)$([ -n "$vlock_srcs" ] && echo " moduledir=$vlock_moduledir")"
echo "macos screensaver: enabled=$([ -n "$saver_srcs" ] && echo 1 || echo 0)$([ -n "$saver_srcs" ] && echo " dir=$saver_dir")"
echo "plasma wallpaper: qt6=$have_qt$([ "$have_qt" = "1" ] && echo " qmldir=$qml_dir packagedir=$plasma_pkgdir")"
echo "run 'make' to build."
